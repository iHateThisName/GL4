  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshPro
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "If you\u2019re reading this, then I\u2019m dead. I know we haven\u2019t
    heard from each other in a while. I know I haven\u2019t been the greatest dad,
    nor the greatest grandpa. Now that my time has come, I leave you my cabin, and
    a single request. When snow falls again, go to the cabin. I know what you and
    the rest of the family think of me, but I ask you to believe my stories, like
    you did so many years ago. There is something about that place, it calls to me,
    telling me that there is something left unfinished. Please go there and close
    the cabin for good, it would mean the world to me. \nBest regards, \nGrandpa.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
