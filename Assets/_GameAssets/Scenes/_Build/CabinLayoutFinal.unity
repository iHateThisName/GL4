--- !u!1001 &1527708711
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 0}
    m_Modifications:
    - target: {fileID: 1006665597269321994, guid: 629bf96767b11354cb90ff4e86b586c5, type: 3}
      propertyPath: m_AnchoredPosition.y
      value: -0.0091
      objectReference: {fileID: 0}
    - target: {fileID: 1101882616068396284, guid: 629bf96767b11354cb90ff4e86b586c5, type: 3}
      propertyPath: m_text
      value: "If you\u2019re reading this, then I\u2019m dead.\n\nI know we haven\u2019t
        heard from each other in a while. I know I haven\u2019t been the greatest
        dad, nor the greatest grandpa. Now that my time has come, I leave you my
        cabin, and a single request. When snow falls again, go to the cabin.\n\nI
        know what you and the rest of the family think of me, but I ask you to believe
        my stories, like you did so many years ago. There is something about that
        place, it calls to me, telling me that there is something left unfinished.\n\nPlease
        go there and close the cabin for good, it would mean the world to me. \nBest
        regards, \nGrandpa.\r\n"
      objectReference: {fileID: 0}
    - target: {fileID: 1101882616068396284, guid: 629bf96767b11354cb90ff4e86b586c5, type: 3}
      propertyPath: m_fontSize
