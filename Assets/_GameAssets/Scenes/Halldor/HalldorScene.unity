--- !u!1001 &232630299
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 0}
    m_Modifications:
    - target: {fileID: 1101882616068396284, guid: 629bf96767b11354cb90ff4e86b586c5, type: 3}
      propertyPath: m_text
      value: "Our flashlight broke, so we have to use this one for now. It\u2019s
        quite old, but at least you don\u2019t need any batteries, this one is powered
        by a handcrank. Make sure to take it with you outside, it\u2019s really easy
        to get lost. You can also scare away any animals lurking around.\n\r\nP.
        S. remind me to buy a new basket to carry our firewood, the one outside only
        fits 6 logs at a time, which is a hassle to deal with.\r\n"
      objectReference: {fileID: 0}
    - target: {fileID: 1101882616068396284, guid: 629bf96767b11354cb90ff4e86b586c5, type: 3}
